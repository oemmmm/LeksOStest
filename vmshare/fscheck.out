== корень
/dev/vda2 f2fs rw,relatime,lazytime,background_gc=on,gc_merge,discard,discard_unit=block,user_xattr,inline_xattr,acl,inline_data,inline_dentry,flush_merge,barrier,extent_cache,mode=adaptive,active_logs=6,alloc_mode=default,checkpoint_merge,fsync_mode=posix,memory=normal,errors=continue,lookup_mode=perf

== /boot
часть корня

== fstab
UUID=e4737922-b349-4cf9-91db-f892588e9b89 /              f2fs    defaults,compress_algorithm=lz4,compress_chksum,gc_merge,lazytime 0 1

== mkinitcpio
MODULES=()
HOOKS=(base systemd autodetect microcode kms modconf block keyboard sd-vconsole filesystems fsck)

== GRUB
GRUB_CMDLINE_LINUX_DEFAULT='nowatchdog nvme_load=YES loglevel=3'
GRUB_CMDLINE_LINUX=""
GRUB_TERMINAL_INPUT=console
GRUB_THEME=/usr/share/grub/themes/leksos/theme.txt
GRUB_GFXMODE=1280x720x32,auto

