часть корня

== fstab

== mkinitcpio
MODULES=()
HOOKS=(base udev autodetect microcode kms modconf block keyboard keymap consolefont zfs filesystems fsck)

== GRUB
GRUB_CMDLINE_LINUX_DEFAULT='zfs=zpleksos/ROOT/leks/root nowatchdog loglevel=3'
GRUB_CMDLINE_LINUX=""
GRUB_TERMINAL_INPUT=console
GRUB_THEME=/usr/share/grub/themes/leksos/theme.txt
GRUB_GFXMODE=1280x720x32,auto

